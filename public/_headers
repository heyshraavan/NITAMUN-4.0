# Cloudflare Pages Caching & Security Headers

# Immutable hashed assets produced by Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static favicons and images (revalidate for instant updates on non-hashed root assets)
/favicon.*
  Cache-Control: public, max-age=3600, must-revalidate
/*.png
  Cache-Control: public, max-age=3600, must-revalidate
/*.jpg
  Cache-Control: public, max-age=3600, must-revalidate
/*.webp
  Cache-Control: public, max-age=3600, must-revalidate
/*.svg
  Cache-Control: public, max-age=3600, must-revalidate
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML entry point - must revalidate for instant deployment propagation
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
