# Client-Side API Endpoints (relative paths served by secure serverless functions)
VITE_SHEETDB_API_URL=/api/register
VITE_SHEETDB_INQUIRY_API_URL=/api/contact

# Server-Side Backend Storage Credentials (used exclusively by serverless functions in /api, never bundled into client JS)
# Configure these in your Vercel Project Environment Variables as encrypted secrets:
SHEETDB_API_URL=https://sheetdb.io/api/v1/YOUR_REGISTRATION_SHEETDB_ID
SHEETDB_INQUIRY_API_URL=https://sheetdb.io/api/v1/YOUR_INQUIRY_SHEETDB_ID
# SHEETDB_BEARER_TOKEN=your_private_bearer_token_here
